<?xml version="1.0"?>
<package format="3">
  <name>weldline_reflectivity_detector</name>
  <version>0.1.0</version>
  <description>ROS 2 scenario commander with precision wall alignment and RGB-D weld-line localization.</description>
  <maintainer email="engineering@cocelo.ai">Cocelo Engineering</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>image_transport</depend>
  <depend>opencv</depend>
  <!-- Runtime dependency: native deb packaging maps this to ros-${ROS_DISTRO}-realsense2-camera. -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
