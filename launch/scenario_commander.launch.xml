<launch>
  <arg name="params_file"
       default="$(find-pkg-share weldline_reflectivity_detector)/config/yolo_weldline_3d.yaml"/>
  <arg name="scenario_file"
       default="$(find-pkg-share weldline_reflectivity_detector)/config/scenario.yaml"/>
  <node pkg="weldline_reflectivity_detector" exec="scenario_commander_node"
        name="scenario_commander_node" output="screen">
    <param from="$(var params_file)"/>
    <param name="scenario_file" value="$(var scenario_file)"/>
  </node>
</launch>
