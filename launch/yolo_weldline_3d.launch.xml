<launch>
  <arg name="start_realsense" default="true"/>
  <arg name="camera_name" default="camera"/>
  <arg name="camera_serial_no" default=""/>
  <arg name="usb_port_id" default=""/>
  <arg name="realsense_initial_reset" default="false"/>
  <arg name="realsense_reconnect_timeout" default="2.0"/>
  <arg name="color_profile" default="640,480,30"/>
  <arg name="depth_profile" default="640,480,30"/>

  <arg name="params_file" default="$(find-pkg-share weldline_goal_publisher)/config/yolo_weldline_3d.yaml"/>
  <arg name="weights" default="$(find-pkg-share weldline_goal_publisher)/weights/best.onnx"/>
  <arg name="color_topic" default="/camera/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/camera/color/camera_info"/>
  <arg name="output_frame" default="map"/>
  <arg name="goal_topic" default="/weldline/goal_pose"/>
  <arg name="processing_rate_hz" default="30.0"/>
  <arg name="target_class_id" default="-1"/>

  <node pkg="realsense2_camera" exec="realsense2_camera_node"
        name="camera" namespace="$(var camera_name)" output="log"
        if="$(var start_realsense)">
    <param name="serial_no" value="$(var camera_serial_no)"/>
    <param name="usb_port_id" value="$(var usb_port_id)"/>
    <param name="enable_color" value="true"/>
    <param name="rgb_camera.color_profile" value="$(var color_profile)"/>
    <param name="rgb_camera.color_format" value="RGB8"/>
    <param name="enable_depth" value="true"/>
    <param name="depth_module.depth_profile" value="$(var depth_profile)"/>
    <param name="depth_module.depth_format" value="Z16"/>
    <param name="enable_infra" value="false"/>
    <param name="enable_infra1" value="false"/>
    <param name="enable_infra2" value="false"/>
    <param name="enable_gyro" value="false"/>
    <param name="enable_accel" value="false"/>
    <param name="enable_sync" value="false"/>
    <param name="align_depth.enable" value="true"/>
    <param name="pointcloud.enable" value="false"/>
    <param name="rgbd.enable" value="false"/>
    <param name="colorizer.enable" value="false"/>
    <param name="decimation_filter.enable" value="false"/>
    <param name="spatial_filter.enable" value="false"/>
    <param name="temporal_filter.enable" value="false"/>
    <param name="disparity_filter.enable" value="false"/>
    <param name="hole_filling_filter.enable" value="false"/>
    <param name="initial_reset" value="$(var realsense_initial_reset)"/>
    <param name="wait_for_device_timeout" value="-1.0"/>
    <param name="reconnect_timeout" value="$(var realsense_reconnect_timeout)"/>
    <param name="rgb_camera.power_line_frequency" value="2"/>
  </node>

  <node pkg="weldline_goal_publisher" exec="weldline_goal_node"
        name="weldline_goal_node" output="screen">
    <param from="$(var params_file)"/>
    <param name="weights" value="$(var weights)"/>
    <param name="color_topic" value="$(var color_topic)"/>
    <param name="depth_topic" value="$(var depth_topic)"/>
    <param name="camera_info_topic" value="$(var camera_info_topic)"/>
    <param name="output_frame" value="$(var output_frame)"/>
    <param name="goal_topic" value="$(var goal_topic)"/>
    <param name="processing_rate_hz" value="$(var processing_rate_hz)"/>
    <param name="target_class_id" value="$(var target_class_id)"/>
  </node>
</launch>
